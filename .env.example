# URL publik HTTP API bot Tsukasa (tanpa garis miring di akhir).
# Opsional: kalau kosong, dipakai https://bot.goyomi.my.id.
# Dipakai untuk panel status live dan deteksi nomor bot (GET /status).
VITE_BOT_API_URL=https://bot.goyomi.my.id

# Nomor WhatsApp bot. Opsional: nomor dideteksi otomatis dari field
# `botNumber` pada GET /status. Isi hanya kalau ingin override manual.
# Format internasional tanpa tanda plus/spasi.
VITE_BOT_NUMBER=

# Link channel WhatsApp (opsional). Kosongkan bila tidak dipakai.
VITE_CHANNEL_URL=
