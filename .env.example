# URL publik HTTP API bot Tsukasa (tanpa garis miring di akhir).
# Dipakai untuk panel status live di landing page (GET /status).
VITE_BOT_API_URL=https://bot.contoh.com

# Nomor WhatsApp bot dalam format internasional tanpa tanda plus/spasi.
# Dipakai tombol "Chat Bot" dan tautan wa.me.
